### 🎮 **Dashboard.tsx** - Main Controller
**ตำแหน่ง:** `app/components/Dashboard.tsx`

```typescript
'use client'  // ← KEY: Client Component (ใช้ hooks)

import { useState } from 'react'
import Sidebar from './Sidebar'
import DashboardPage from './DashboardPage'
import AnalyticsPage from './AnalyticsPage'
import UsersPage from './UsersPage'
import ContentPage from './ContentPage'
import AICoachPage from './AICoachPage'
import RevenuePage from './RevenuePage'
import NotificationsPage from './NotificationsPage'
import SettingsPage from './SettingsPage'

export default function Dashboard() {
  // ┌── State management: track current page
  // └── activePage = 'dashboard' | 'analytics' | 'users' | etc.
  const [activePage, setActivePage] = useState('dashboard')

  // ┌── Conditional rendering function
  // ├── Input: activePage string
  // └── Output: JSX component
  const renderPage = () => {
    switch (activePage) {
      case 'dashboard':
        return <DashboardPage />
      case 'analytics':
        return <AnalyticsPage />
      case 'users':
        return <UsersPage />
      case 'content':
        return <ContentPage />
      case 'ai-coach':
        return <AICoachPage />
      case 'revenue':
        return <RevenuePage />
      case 'notifications':
        return <NotificationsPage />
      case 'settings':
        return <SettingsPage />
      default:
        return <DashboardPage />
    }
  }

  return (
    // ┌── Flex layout: 2 columns
    // ├── h-screen = 100vh (full height)
    // └── bg-[#0f0f0f] = dark background
    <div className="flex h-screen bg-[#0f0f0f]">
      {/* ┌── Sidebar: Navigation Menu
          ├── Props: currentPage + function to change it
          └── User clicks here to switch pages */}
      <Sidebar activePage={activePage} setPage={setActivePage} />
      
      {/* ┌── Main Content Area
          ├── flex-1 = take remaining space
          └── overflow-auto = scrollable if content tall */}
      <main className="flex-1 overflow-auto">
        <div className="p-8">  {/* ← 8 = 2rem padding */}
          {renderPage()}  {/* ← Dynamic component based on activePage */}
        </div>
      </main>
    </div>
  )
}
```

**ทำหน้าที่:**
- ✅ **Single Source of Truth** - `activePage` state นี่เดียว
- ✅ **Routing Logic** - switch statement เลือก component
- ✅ **Layout** - Flex layout sidebar + content
- ✅ **Props Drilling** - ส่ง state/setter ให้ Sidebar

**ทำไมต้อง `'use client'`:**
```typescript
// ❌ Server Component ไม่ได้ใช้ hooks
'use client' // ← ERROR: hooks ต้องใน client component

// ✅ Client Component อนุญาต useState
'use client'
export default function Dashboard() {
  const [activePage, setActivePage] = useState('dashboard') // ✅ OK
}
```

---

### 🎯 **Sidebar.tsx** - Navigation Menu
**ตำแหน่ง:** `app/components/Sidebar.tsx`

```typescript
'use client'

import { BarChart3, Users, Settings, Zap, AlertCircle, DollarSign, FileText } from 'lucide-react'

interface SidebarProps {
  activePage: string
  setPage: (page: string) => void
}

export default function Sidebar({ activePage, setPage }: SidebarProps) {
  // ┌── Menu structure: organized by section
  const sections = [
    {
      title: 'OVERVIEW',
      items: [
        { label: 'Dashboard', icon: BarChart3, key: 'dashboard' },
        { label: 'Analytics', icon: BarChart3, key: 'analytics' }
      ]
    },
    {
      title: 'MANAGEMENT',
      items: [
        { label: 'Users', icon: Users, key: 'users' },
        { label: 'Content', icon: FileText, key: 'content' },
        { label: 'AI Coach', icon: Zap, key: 'ai-coach' }
      ]
    },
    {
      title: 'BUSINESS',
      items: [
        { label: 'Revenue', icon: DollarSign, key: 'revenue' },
        { label: 'Notifications', icon: AlertCircle, key: 'notifications' },
        { label: 'Settings', icon: Settings, key: 'settings' }
      ]
    }
  ]

  return (
    // ┌── w-64 = 16rem width (260px)
    // ├── bg-[#1a1a1a] = dark gray
    // └── border-r = right border (vertical line)
    <aside className="w-64 bg-[#1a1a1a] border-r border-gray-800 p-6">
      <h1 className="text-2xl font-bold text-white mb-8">FitAI</h1>

      <nav className="space-y-8">  {/* ┌─ space-y-8 = 2rem between sections */}
        {sections.map((section) => (
          <div key={section.title}>
            {/* ┌── Section title: OVERVIEW, MANAGEMENT, etc. */}
            <p className="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4">
              {section.title}
            </p>

            {/* ┌── Menu items under this section */}
            <ul className="space-y-2">
              {section.items.map((item) => {
                const Icon = item.icon  {/* ┌── Get icon component */}
                
                // ┌── Determine if this item is active
                // └── If active: green background, else: gray
                const isActive = activePage === item.key
                
                return (
                  <li key={item.label}>
                    <button
                      onClick={() => setPage(item.key)}  {/* ┌── Change page on click */}
                      className={`flex items-center gap-3 w-full px-4 py-2 rounded-lg transition-colors ${
                        isActive
                          ? 'bg-[#22c55e] text-black'  {/* ┌─ Green when active */}
                          : 'text-gray-400 hover:bg-[#2a2a2a] hover:text-[#22c55e]'  {/* ├─ Gray + hover effect */}
                      }`}
                    >
                      <Icon size={18} />  {/* ┌── Icon from lucide-react */}
                      <span className="text-sm">{item.label}</span>
                    </button>
                  </li>
                )
              })}
            </ul>
          </div>
        ))}
      </nav>
    </aside>
  )
}
```

**ทำหน้าที่:**
- ✅ **Navigation Menu** - เมามี 3 section
- ✅ **Active State** - highlight ปุ่มที่ active (สีเขียว)
- ✅ **Hover Effects** - ให้ UX รู้สึกเป็น interactive
- ✅ **Icons** - Visual indicators จาก lucide-react

**Structure ของ sections:**
```
OVERVIEW
  └── Dashboard ✅ (green if active)
  └── Analytics

MANAGEMENT
  └── Users
  └── Content
  └── AI Coach

BUSINESS
  └── Revenue
  └── Notifications
  └── Settings
```

