### 📊 **DashboardPage.tsx** - Main Dashboard
**ตำแหน่ง:** `app/components/DashboardPage.tsx`

```typescript
'use client'

import { UseDashboardData } from '../hooks/useDashboardData'
import StatCard from './StatCard'
import PageHeader from './PageHeader'
import LoadingSpinner from './LoadingSpinner'
import ErrorMessage from './ErrorMessage'
import DataTable from './DataTable'
import ChartContainer from './ChartContainer'
import { BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer, PieChart, Pie, Cell } from 'recharts'

interface User {
  id: string
  email: string
  name: string
  goal: string
  weight: number
  plan: string
  created_at: string
}

export default function DashboardPage() {
  // ┌── Hook: Fetch all dashboard data
  // └── Returns: stats, charts data, loading, error
  const { stats, signupsData, goalData, recentUsers, loading, error } = UseDashboardData()

  // ┌── Colors for pie chart
  const COLORS = ['#22c55e', '#3b82f6', '#f59e0b', '#ef4444']

  // ┌── STATE CHECK 1: Loading
  if (loading) {
    return <LoadingSpinner className="h-64" />
  }

  // ┌── STATE CHECK 2: Error
  if (error) {
    return <ErrorMessage message={error} />
  }

  // ┌── Define table columns
  // ├── key: which field from User object
  // ├── header: column title
  // └── render?: custom formatter function
  const userColumns = [
    { key: 'name' as keyof User, header: 'Name' },
    { key: 'email' as keyof User, header: 'Email' },
    {
      key: 'goal' as keyof User,
      header: 'Goal',
      // ┌── Custom formatter: replace underscore + uppercase
      render: (value: string) => value.replace('_', ' ').toUpperCase()
    },
    {
      key: 'plan' as keyof User,
      header: 'Plan',
      render: (value: string) => value.toUpperCase()
    },
    {
      key: 'created_at' as keyof User,
      header: 'Joined',
      // ┌── Format date to Thai locale
      render: (value: string) => new Date(value).toLocaleDateString('th-TH')
    }
  ]

  return (
    <div className="space-y-8">  {/* ┌── space-y-8 = 2rem between sections */}
      {/* ┌── Page title + description */}
      <PageHeader title="Dashboard" subtitle="FitAI Health Coach Admin Overview" />

      {/* ┌── 4 StatCards in responsive grid
          ├── lg:grid-cols-4 = 4 columns on desktop
          ├── md:grid-cols-2 = 2 columns on tablet
          └── grid-cols-1 = 1 column on mobile */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <StatCard
          title="Total Users"
          value={stats.totalUsers.toLocaleString()}  {/* ┌── Format: 1,234 */}
          sub="Registered users"
          color="#22c55e"  {/* ┌── Green */}
        />
        <StatCard
          title="Pro Subscribers"
          value={stats.proUsers.toLocaleString()}
          sub="Paid users"
          color="#3b82f6"  {/* ┌── Blue */}
        />
        <StatCard
          title="Active Today"
          value={stats.activeToday.toLocaleString()}
          sub="New signups"
          color="#f59e0b"  {/* ┌── Orange */}
        />
        <StatCard
          title="Monthly Recurring Revenue"
          value={`$${stats.mrr.toLocaleString()}`}
          sub="MRR"
          color="#ef4444"  {/* ┌── Red */}
        />
      </div>

      {/* ┌── 2-column grid on large screens */}
      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {/* ┌── Chart 1: Bar Chart - Signups Last 7 Days */}
        <ChartContainer title="Signups Last 7 Days">
          <ResponsiveContainer width="100%" height={300}>
            <BarChart data={signupsData}>  {/* ┌── signupsData = [ { date, count } ] */}
              <CartesianGrid strokeDasharray="3 3" stroke="#374151" />  {/* ┌── Grid lines */}
              <XAxis dataKey="date" stroke="#9ca3af" />  {/* ┌── X-axis: date labels */}
              <YAxis stroke="#9ca3af" />  {/* ┌── Y-axis: count numbers */}
              <Tooltip
                contentStyle={{ backgroundColor: '#1a1a1a', border: '1px solid #374151' }}
                labelStyle={{ color: '#fff' }}
              />  {/* ┌── Hover tooltip */}
              <Bar dataKey="count" fill="#22c55e" />  {/* ┌── Green bars */}
            </BarChart>
          </ResponsiveContainer>
        </ChartContainer>

        {/* ┌── Chart 2: Pie Chart - Goal Distribution */}
        <ChartContainer title="Goal Distribution">
          <ResponsiveContainer width="100%" height={300}>
            <PieChart>
              <Pie
                data={goalData}  {/* ┌── goalData = [ { name, value } ] */}
                cx="50%"
                cy="50%"
                labelLine={false}
                // ┌── Label format: "Weight Loss 45%"
                label={({ name, percent }) => `${name} ${((percent || 0) * 100).toFixed(0)}%`}
                outerRadius={80}
                fill="#8884d8"
                dataKey="value"  {/* ┌── Use 'value' field for sizing */}
              >
                {/* ┌── Map colors from COLORS array */}
                {goalData.map((entry: { name: string; value: number }, index: number) => (
                  <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />
                ))}
              </Pie>
              <Tooltip
                contentStyle={{ backgroundColor: '#1a1a1a', border: '1px solid #374151' }}
                labelStyle={{ color: '#fff' }}
              />
            </PieChart>
          </ResponsiveContainer>
        </ChartContainer>
      </div>

      {/* ┌── Recent Users Table */}
      <ChartContainer title="Recent Users">
        <DataTable data={recentUsers} columns={userColumns} />
      </ChartContainer>
    </div>
  )
}
```

**ทำหน้าที่:**
- ✅ **3 States**: loading → error → data
- ✅ **StatCards**: 4 key metrics
- ✅ **BarChart**: Signups trend over 7 days
- ✅ **PieChart**: Goal distribution breakdown
- ✅ **Table**: Recent users list

**Responsive Layout:**
```
Desktop (lg):
┌─ StatCard │ StatCard │ StatCard │ StatCard ─┐
├─ Chart 1 │ Chart 2 ─┤
├─ Table (full width) ─┤

Tablet (md):
┌─ StatCard │ StatCard ─┐
├─ StatCard │ StatCard ─┤
├─ Chart 1 ─┤
├─ Chart 2 ─┤
├─ Table ─┤

Mobile:
┌─ StatCard ─┐
├─ StatCard ─┤
├─ Chart 1 ─┤
├─ Chart 2 ─┤
└─ Table ─┘
```

