## 3. ไฟล์แต่ละตัว

### 📄 **layout.tsx** - Root Container
**ตำแหน่ง:** `app/layout.tsx`

```typescript
import type { Metadata } from 'next';
import { Geist, Geist_Mono } from 'next/font/google';
import './globals.css';

const geistSans = Geist({
  variable: '--font-geist-sans',
  subsets: ['latin']
});

const geistMono = Geist_Mono({
  variable: '--font-geist-mono',
  subsets: ['latin']
});

// ┌─ เมตาดาต้าของหน้า - แสดงในแท็บ browser
export const metadata: Metadata = {
  title: 'FitAI Dashboard',
  description: 'Admin dashboard for FitAI Health Coach'
};

export default function RootLayout({ children }: { children: React.ReactNode }) {
  return (
    // ┌─ lang='en' → ตั้งค่าภาษา HTML
    // ├─ className: Font variables + antialiased (smooth text)
    <html lang='en' className={`${geistSans.variable} ${geistMono.variable} h-full antialiased`}>
      {/* ┌─ min-h-full → Full height ถ้าเนื้อหาน้อย
          ├─ flex flex-col → ให้เหลามค้นจัดเรียงแนวตั้ง */}
      <body className='min-h-full flex flex-col'>{children}</body>
    </html>
  );
}
```

**ทำหน้าที่:**
- ✅ ตั้งค่า HTML หลัก (meta tags, lang, doctype)
- ✅ โหลด Google Fonts (Geist)
- ✅ นำเข้า Global CSS (globals.css)
- ✅ Antialiased = ข้อความเรียบ (font smoothing)

**ทำไมเขียนแบบนี้:**
- Next.js ต้องการ `layout.tsx` ที่ root
- `metadata` object = SEO + browser tab title
- `children` = placeholder สำหรับทุก page ที่อยู่ข้างใน

