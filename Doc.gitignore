## 4. Hook Functions - ตัวดึงข้อมูล

### 🪝 **useDashboardData.ts**
**ตำแหน่ง:** `app/hooks/useDashboardData.ts`

```typescript
import { useEffect, useState } from 'react'
import { supabase } from '@/lib/supabase'

interface DashboardStats {
  totalUsers: number
  proUsers: number
  activeToday: number
  mrr: number
}

interface User {
  id: string
  email: string
  name: string
  goal: string
  weight: number
  plan: string
  created_at: string
}

export function UseDashboardData() {
  // ┌── State 1: Statistics
  const [stats, setStats] = useState<DashboardStats>({
    totalUsers: 0,
    proUsers: 0,
    activeToday: 0,
    mrr: 0
  })

  // ┌── State 2: Signups chart data
  const [signupsData, setSignupsData] = useState<{ date: string; count: number }[]>([])

  // ┌── State 3: Goal pie chart data
  const [goalData, setGoalData] = useState<{ name: string; value: number }[]>([])

  // ┌── State 4: Recent users list
  const [recentUsers, setRecentUsers] = useState<User[]>([])

  // ┌── State 5-6: Loading & error states
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState<string | null>(null)

  // ┌── Side effect: Fetch data when component mounts
  // └── Empty dependency array = run ONCE
  useEffect(() => {
    fetchDashboardData()
  }, [])

  const fetchDashboardData = async () => {
    try {
      setLoading(true)
      setError(null)

      // ┌── Query 1: Count all users
      // └── count: 'exact' = get actual count (not data)
      const { count: totalUsers } = await supabase
        .from('users')
        .select('*', { count: 'exact', head: true })

      // ┌── Query 2: Count pro users only
      const { count: proUsers } = await supabase
        .from('users')
        .select('*', { count: 'exact', head: true })
        .eq('plan', 'pro')  // ┌── Filter: where plan = 'pro'

      // ┌── Query 3: Count today signups
      const today = new Date().toISOString().split('T')[0]  // ┌── e.g., "2026-03-28"
      const { count: activeToday } = await supabase
        .from('users')
        .select('*', { count: 'exact', head: true })
        .gte('created_at', today)  // ┌── Filter: created_at >= today

      // ┌── Calculate MRR
      const mrr = (proUsers || 0) * 299

      // ┌── Update stats state
      setStats({
        totalUsers: totalUsers || 0,
        proUsers: proUsers || 0,
        activeToday: activeToday || 0,
        mrr
      })

      // ┌── Query 4: Get signups from last 7 days
      const sevenDaysAgo = new Date()
      sevenDaysAgo.setDate(sevenDaysAgo.getDate() - 7)  // ┌── Subtract 7 days

      const { data: signups } = await supabase
        .from('users')
        .select('created_at')
        .gte('created_at', sevenDaysAgo.toISOString())  // ┌── Only last 7 days

      // ┌── Process signups: group by date
      const signupsMap = new Map<string, number>()

      // ┌── Initialize: create entry for each of 7 days with count=0
      for (let i = 0; i < 7; i++) {
        const date = new Date()
        date.setDate(date.getDate() - i)
        const dateStr = date.toISOString().split('T')[0]  // ┌── "2026-03-28"
        signupsMap.set(dateStr, 0)
      }

      // ┌── Count signups per day
      signups?.forEach(user => {
        const date = new Date(user.created_at).toISOString().split('T')[0]
        signupsMap.set(date, (signupsMap.get(date) || 0) + 1)
      })

      // ┌── Convert map to array and sort by date
      const signupsArray = Array.from(signupsMap.entries())
        .map(([date, count]) => ({ date, count }))
        .sort((a, b) => a.date.localeCompare(b.date))

      setSignupsData(signupsArray)

      // ┌── Query 5: Get goal distribution
      const { data: goals } = await supabase
        .from('users')
        .select('goal')

      // ┌── Process goals: count each goal type
      const goalCounts = goals?.reduce((acc: Record<string, number>, user: { goal: string }) => {
        acc[user.goal] = (acc[user.goal] || 0) + 1  // ┌── Tally count
        return acc
      }, {} as Record<string, number>) || {}

      // ┌── Convert to array format for pie chart
      const goalArray = Object.entries(goalCounts)
        .map(([name, value]) => ({
          name: name.replace('_', ' ').toUpperCase(),  // ┌── "weight_loss" → "WEIGHT LOSS"
          value
        }))

      setGoalData(goalArray)

      // ┌── Query 6: Get recent users
      const { data: recent } = await supabase
        .from('users')
        .select('*')
        .order('created_at', { ascending: false })  // ┌── Newest first
        .limit(10)  // ┌── Only last 10

      setRecentUsers(recent || [])

    } catch (err) {
      setError(err instanceof Error ? err.message : 'Failed to fetch data')
    } finally {
      setLoading(false)
    }
  }

  return { stats, signupsData, goalData, recentUsers, loading, error }
}
```

**ทำหน้าที่:**
- ✅ **State Management**: Store stats, charts, users
- ✅ **Multiple Queries**: 6 separate DB queries
- ✅ **Data Processing**: Format dates, count aggregations
- ✅ **Error Handling**: Try-catch + error state

**Query Summary:**
| Query | Purpose | Result |
|-------|---------|--------|
| 1 | Count all users | totalUsers |
| 2 | Count pro users | proUsers |
| 3 | Count today signups | activeToday |
| 4 | Last 7 days signups | signupsData array |
| 5 | Goal distribution | goalData pie chart |
| 6 | Recent 10 users | recentUsers table |

