### 🔔 **NotificationsPage.tsx** - Activity Log
**ตำแหน่ง:** `app/components/NotificationsPage.tsx`

```typescript
'use client'

import { UseNotificationsData } from '../hooks/useNotificationsData'
import PageHeader from './PageHeader'
import LoadingSpinner from './LoadingSpinner'
import ErrorMessage from './ErrorMessage'

interface Activity {
  id: string
  type: 'user_signup' | 'workout_completed' | 'ai_message'
  description: string
  time: string
  user_name?: string
}

export default function NotificationsPage() {
  // ┌── Hook: Fetch recent activities
  const { activities, loading, error } = UseNotificationsData()

  // ┌── Map activity type → emoji icon
  const getActivityIcon = (type: string) => {
    switch (type) {
      case 'user_signup':
        return '👤'
      case 'workout_completed':
        return '💪'
      case 'ai_message':
        return '🤖'
      default:
        return '📌'
    }
  }

  if (loading) return <LoadingSpinner className="h-64" />
  if (error) return <ErrorMessage message={error} />

  return (
    <div className="space-y-8">
      <PageHeader title="Notifications" subtitle="Recent user activities and system events" />

      <div className="bg-[#1a1a1a] border border-gray-800 rounded-lg p-6">
        <h3 className="text-lg font-semibold text-white mb-4">Recent Activities</h3>
        
        {/* ┌── Activities feed: vertical list */}
        <div className="space-y-4">
          {activities.map((activity: Activity) => (
            <div key={activity.id} className="flex items-start gap-4 p-4 bg-[#2a2a2a] rounded-lg">
              {/* ┌── Emoji icon based on activity type */}
              <div className="text-2xl">
                {getActivityIcon(activity.type)}
              </div>
              
              {/* ┌── Activity text + timestamp */}
              <div className="flex-1">
                <p className="text-gray-300">
                  {activity.description}  {/* ┌── e.g., "User John signed up" */}
                </p>
                <p className="text-gray-500 text-sm mt-1">
                  {/* ┌── Timestamp in Thai format */}
                  {new Date(activity.time).toLocaleString('th-TH')}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  )
}
```

**ทำหน้าที่:**
- ✅ **Activity Stream**: Recent events
- ✅ **Activity Types**: User signup, Workout done, AI chat
- ✅ **Visual Icons**: Emoji for each type
- ✅ **Timeline**: Newest first

