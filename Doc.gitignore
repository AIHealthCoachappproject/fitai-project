### 🪝 **useAICoachData.ts**
**ตำแหน่ง:** `app/hooks/useAICoachData.ts`

```typescript
import { useEffect, useState, useMemo } from 'react'
import { supabase } from '@/lib/supabase'

interface AIChat {
  id: string
  user_id: string
  message: string
  role: string  // 'user' | 'assistant'
  created_at: string
  users?: {
    name: string
  }
}

export function UseAICoachData() {
  const [chats, setChats] = useState<AIChat[]>([])
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState<string | null>(null)
  const [roleFilter, setRoleFilter] = useState<string>('all')

  useEffect(() => {
    fetchChats()
  }, [])

  const fetchChats = async () => {
    try {
      setLoading(true)
      setError(null)

      // ┌── Query: Get AI chats with JOIN to users table
      const { data, error } = await supabase
        .from('ai_chats')
        .select(`
          *,
          users (
            name
          )
        `)
        .order('created_at', { ascending: false })  // ┌── Newest first

      if (error) throw error

      setChats(data || [])

    } catch (err) {
      setError(err instanceof Error ? err.message : 'Failed to fetch chats')
    } finally {
      setLoading(false)
    }
  }

  // ┌── useMemo: Compute filtered chats only when deps change
  // └── Prevents unnecessary recalculation
  const filteredChats = useMemo(() => {
    let filtered = chats

    if (roleFilter !== 'all') {
      filtered = filtered.filter(chat => chat.role === roleFilter)  // ┌── Filter by role
    }

    return filtered
  }, [chats, roleFilter])  // ┌── Recalculate if chats or roleFilter changes

  return {
    chats: filteredChats,  // ┌── Return filtered chats
    loading,
    error,
    roleFilter,
    setRoleFilter,
    refetch: fetchChats
  }
}
```

**ทำหน้าที่:**
- ✅ **Fetch AI Chats**: Query with JOIN
- ✅ **Filter by Role**: User vs Assistant
- ✅ **Memoization**: Optimize filter computation

**JOIN Query Explained:**
```typescript
// Query structure:
.select(`
  *,              // ┌── All columns from ai_chats
  users (         // ├── JOIN with users table
    name          // └── Return user's name
  )
`)

// Result structure:
{
  id: "chat1",
  message: "Hello",
  role: "user",
  user_id: "user1",
  users: {        // ┌── Joined user info
    name: "John"
  }
}
```

